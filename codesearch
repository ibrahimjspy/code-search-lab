#!/usr/bin/env python3
"""Local code intelligence through a CLI or a shared warm service."""
import argparse
import json
import os
from pathlib import Path
import sys
import time
from paths import APP, source_root, venv_python


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = ['index','search','symbol','embed','start','status','stop','sync','mcp',
                'definitions','references','imports','calls','callers','read']
    parser.add_argument('command',choices=commands)
    parser.add_argument('query',nargs='?')
    parser.add_argument('--repo',type=Path,help='Source directory; defaults to current directory')
    parser.add_argument('--db',type=Path,help='Database override for --local operations')
    parser.add_argument('--mode',choices=['auto','bm25','dense','hybrid','regex'],default='auto')
    parser.add_argument('--limit',type=int,default=5)
    parser.add_argument('--path')
    parser.add_argument('--file')
    parser.add_argument('--line',type=int)
    parser.add_argument('--end-line',type=int)
    parser.add_argument('--column',type=int,default=0)
    parser.add_argument('--context',type=Path,help='Request-local editor context JSON')
    parser.add_argument('--active-file')
    parser.add_argument('--git-diff',action='store_true')
    parser.add_argument('--sync-path',action='append',default=[])
    parser.add_argument('--full-sync',action='store_true')
    parser.add_argument('--warm-model',action='store_true',help='Preload model/vectors when starting the service')
    parser.add_argument('--local',action='store_true',help='Bypass an existing service')
    parser.add_argument('--require-service',action='store_true')
    parser.add_argument('--include-docs',action='store_true')
    parser.add_argument('--json',action='store_true')
    args = parser.parse_args()
    root = (Path(args.repo or Path.cwd()).expanduser().resolve() if args.command in {'status','stop'}
            else source_root(args.repo))
    if args.command in {'search','symbol'} and not args.query: parser.error('A query is required.')
    if not 1<=args.limit<=50: parser.error('--limit must be 1-50.')
    if args.db:
        if args.require_service: parser.error('--db and --require-service cannot be combined.')
        args.local = True
    started = time.perf_counter()
    from service import request, running, start, stop
    control = args.command in {'start','mcp'}
    remote = None if args.local else running(root)
    needs_venv = control or remote is None and (args.command=='embed' or args.mode in {'dense','hybrid','regex'})
    if needs_venv and Path(sys.prefix).resolve()!=(APP/'.venv').resolve():
        python = venv_python()
        if python.exists():
            os.execv(str(python),[str(python),str(APP/'codesearch'),*sys.argv[1:]])
        import importlib.util
        modules = ['mcp','watchdog','filelock'] if control else ['regex'] if args.mode=='regex' else ['sentence_transformers']
        if not all(importlib.util.find_spec(name) for name in modules):
            raise RuntimeError('Run python setup.py --service (and --embeddings for semantic search).')
    if args.command=='start': payload = start(root,args.warm_model)
    elif args.command=='mcp':
        from mcp_server import run
        run(root); return
    elif args.command=='status': payload = remote or {'running':False,'root':str(root)}
    elif args.command=='stop': payload = stop(root)
    else:
        context = {}
        if args.context:
            if args.context.stat().st_size>100000: raise ValueError('Context file is too large.')
            context = json.loads(args.context.read_text(encoding='utf-8'))
        if args.active_file: context['active_file'] = args.active_file
        parameters = {'query':args.query or '', 'mode':args.mode if args.command=='search' else args.command,
                      'limit':args.limit,'path':args.path,'file':args.file,'line':args.line,'column':args.column,
                      'context':context,'include_docs':args.include_docs,'include_git_diff':args.git_diff}
        operation = 'query'
        if args.command in {'index','sync'}: operation,parameters = 'sync',{}
        elif args.command=='embed': operation,parameters = 'warm',{}
        elif args.command=='read':
            operation,parameters = 'read',{'file':args.file or args.query,'start':args.line or 1,'end':args.end_line}
        if remote:
            payload = request(root,operation,parameters | {'sync_paths':args.sync_path,'full_sync':args.full_sync},timeout=1800)
        else:
            if args.require_service: raise RuntimeError('No service is running; use codesearch start.')
            from intelligence import Intelligence
            kb = Intelligence(root,args.db)
            try:
                if operation=='query': payload = kb.query(**parameters)
                elif operation=='read': payload = kb.read(**parameters)
                elif operation=='warm': payload = kb.dense_index().stats
                else: payload = kb.status()
                payload['freshness'] = {'full_sync':True,'consistency':'standalone scan'}
            finally: kb.close()
        payload['repo'] = str(root)
    payload['client_elapsed_ms'] = round((time.perf_counter()-started)*1000,2)
    if args.json or 'results' not in payload: print(json.dumps(payload,indent=2))
    else:
        print(f"{payload.get('route',{}).get('mode','')} | generation {payload.get('generation')} | {payload['client_elapsed_ms']} ms")
        for result in payload['results']:
            if 'preview' not in result: print(json.dumps(result)); continue
            print(f"\n{result['file']}:{result['start']}-{result['end']} [{result['qualified_symbol']}]")
            for number,line in enumerate(result['preview'].splitlines(),result['preview_start']):
                print(f'  {number}: {line}')


if __name__=='__main__':
    sys.stdout.reconfigure(encoding='utf-8')
    sys.stderr.reconfigure(encoding='utf-8')
    try: main()
    except Exception as exc:
        print(f'codesearch: {exc}',file=sys.stderr)
        sys.exit(1)
